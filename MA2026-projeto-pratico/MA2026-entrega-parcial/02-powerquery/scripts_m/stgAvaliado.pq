// stgAvaliado — todas as linhas, com de-para, cálculos e motivo de rejeição
// Os alertas de preço e categoria são mantidos; não causam exclusão.
let
    Fonte = stgPedidos,
    TextoBasico = Table.TransformColumns(Fonte, {
        {"Pedido_ID", each if _ = null then "" else Text.Trim(Text.From(_)),type text},
        {"SKU", each fnChave(_),type text},
        {"Lojista", each fnChave(_),type text},
        {"UF", each fnChave(_),type text},
        {"Status", each fnChave(_),type text},
        {"Motivo", each fnChave(_),type text}}),
    DataLimpa = Table.AddColumn(TextoBasico,"Data_Trat",each fnData([Data_Pedido]),type date),
    QtdLimpa = Table.AddColumn(DataLimpa,"Qtd_Trat",each fnNumero([Quantidade]),type number),
    PrecoLimpo = Table.AddColumn(QtdLimpa,"Valor_Unit_Trat",each fnNumero([Valor_Unitario]),type number),
    DescontoLimpo = Table.AddColumn(PrecoLimpo,"Desconto_Trat",each fnNumero([Desconto]),type number),
    DiasLimpos = Table.AddColumn(DescontoLimpo,"Dias_Trat",each fnNumero([Dias_Despacho]),type number),
    NomeLojista = Table.NestedJoin(DiasLimpos,{"Lojista"},deParaLojista,{"Chave_Lojista"},"J_Lojista",JoinKind.LeftOuter),
    LojistaExpandido = Table.ExpandTableColumn(NomeLojista,"J_Lojista",{"Cod_Lojista"},{"Cod_Lojista"}),
    ProdutoJoin = Table.NestedJoin(LojistaExpandido,{"SKU"},dProduto,{"Cod_Produto"},"J_Produto",JoinKind.LeftOuter),
    ProdutoExpandido = Table.ExpandTableColumn(ProdutoJoin,"J_Produto",{"Produto","Categoria","Preco_Referencia"},{"Produto_Cad","Categoria_Cad","Preco_Referencia"}),
    MapaStatus = #table(type table [Origem=text, Padrao=text], {
        {"CONCLUÍDO", "Concluído"},
       {"ENTREGUE", "Concluído"},
       {"FINALIZADO", "Concluído"},
       {"CANCELADO", "Cancelado"},
       {"CANCELADA", "Cancelado"},
       {"DEVOLVIDO", "Devolvido"},
       {"DEVOLUÇÃO", "Devolvido"},
       {"REEMBOLSADO", "Devolvido"}
    }),
    StatusLimpo = Table.AddColumn(ProdutoExpandido,"Status_Trat", each let statusAtual=[Status], r=Table.SelectRows(MapaStatus,(m)=>m[Origem]=statusAtual) in if Table.RowCount(r)=0 then null else r{0}[Padrao], type text),
    MapaMotivo = #table(type table [Origem=text, Padrao=text], {
        {"SEM ESTOQUE", "Sem estoque"},
       {"FALTA DE ESTOQUE", "Sem estoque"},
       {"PAGAMENTO RECUSADO", "Pagamento recusado"},
       {"PAGAMENTO NÃO APROVADO", "Pagamento recusado"},
       {"DESISTÊNCIA", "Desistência"},
       {"DESISTÊNCIA DO COMPRADOR", "Desistência"},
       {"DESPACHO ATRASADO", "Atraso no despacho"},
       {"PRAZO DE DESPACHO", "Atraso no despacho"},
       {"DEFEITO", "Produto com defeito"},
       {"PRODUTO COM DEFEITO", "Produto com defeito"},
       {"DIVERGÊNCIA DO ANÚNCIO", "Divergência do anúncio"},
       {"ITEM DIFERENTE", "Divergência do anúncio"},
       {"ARREPENDIMENTO", "Arrependimento"},
       {"DESISTÊNCIA APÓS ENTREGA", "Arrependimento"},
       {"ENTREGA ATRASADA", "Atraso na entrega"},
       {"ATRASO NA ENTREGA", "Atraso na entrega"}
    }),
    MotivoLimpo = Table.AddColumn(StatusLimpo,"Motivo_Trat", each if [Status_Trat] = "Concluído" then "" else let motivoAtual=[Motivo], r=Table.SelectRows(MapaMotivo,(m)=>m[Origem]=motivoAtual) in if Table.RowCount(r)=0 then null else r{0}[Padrao], type text),
    Mes = Table.AddColumn(MotivoLimpo,"Mes_Inicio",each if [Data_Trat]=null then null else Date.StartOfMonth([Data_Trat]),type date),
    Canal = Table.AddColumn(Mes,"Canal_Trat",each if [Canal]=null then "Site" else if fnChave([Canal])="APP" or fnChave([Canal])="APLICATIVO" then "Aplicativo" else if fnChave([Canal])="MARKETPLACE" then "Marketplace" else "Site",type text),
    Bruto = Table.AddColumn(Canal,"Valor_Bruto",each if [Qtd_Trat]=null or [Valor_Unit_Trat]=null then null else Number.Round([Qtd_Trat]*[Valor_Unit_Trat],2),type number),
    Liquido = Table.AddColumn(Bruto,"Valor_Liquido",each if [Valor_Bruto]=null or [Desconto_Trat]=null then null else Number.Round([Valor_Bruto]-[Desconto_Trat],2),type number),
    Afetado = Table.AddColumn(Liquido,"Valor_Afetado", each if [Valor_Liquido]=null then null else if [Status_Trat]="Cancelado" or [Status_Trat]="Devolvido" then [Valor_Liquido] else 0,type number),
    ComIndice = Table.AddIndexColumn(Table.Sort(Afetado,{{"Arquivo_Origem",Order.Ascending},{"Linha_Origem",Order.Ascending}}),"Indice_Leitura",0,1,Int64.Type),
    Duplicatas = Table.Group(ComIndice,{"Pedido_ID"},{{"Primeiro_Indice",each List.Min([Indice_Leitura]),Int64.Type}}),
    J_Duplicata = Table.NestedJoin(ComIndice,{"Pedido_ID"},Duplicatas,{"Pedido_ID"},"J_Dupl",JoinKind.LeftOuter),
    Exp_Duplicata = Table.ExpandTableColumn(J_Duplicata,"J_Dupl",{"Primeiro_Indice"},{"Primeiro_Indice"}),
    Validacoes = Table.AddColumn(Exp_Duplicata,"Motivos_Rejeicao", each Text.Combine(List.RemoveNulls({
        if (try [Pedido_ID]="" otherwise true) then "Pedido sem identificador" else null,
        if (try [Cod_Lojista]=null otherwise true) then "Lojista sem correspondência" else null,
        if (try [Produto_Cad]=null otherwise true) then "SKU não cadastrado" else null,
        if (try [Data_Trat]=null otherwise true) then "Data inválida" else null,
        if (try [Qtd_Trat]=null or [Qtd_Trat]<=0 or Number.RoundDown([Qtd_Trat])<>[Qtd_Trat] otherwise true) then "Quantidade inválida" else null,
        if (try [Valor_Unit_Trat]=null or [Valor_Unit_Trat]<=0 otherwise true) then "Valor unitário inválido" else null,
        if (try [Desconto_Trat]=null or [Desconto_Trat]<0 otherwise true) then "Desconto inválido" else null,
        if (try [Status_Trat]=null otherwise true) then "Status fora da lista" else null,
        if (try ([Status_Trat]="Cancelado" or [Status_Trat]="Devolvido") and [Motivo_Trat]=null otherwise true) then "Motivo não reconhecido" else null,
        if (try Text.Length([CEP])<>8 otherwise true) then "CEP com formato inválido" else null,
        if (try [Dias_Trat]=null or [Dias_Trat]<0 otherwise true) then "Dias de despacho inválidos" else null,
        if (try [Indice_Leitura]<>[Primeiro_Indice] otherwise true) then "Pedido duplicado" else null
    }),"; "),type text),
    RegistroSaida = Table.AddColumn(Validacoes,"Saida",each [
       Pedido_ID=[Pedido_ID], Data_Pedido=[Data_Trat], Mes_Inicio=[Mes_Inicio],
       Cod_Lojista=[Cod_Lojista], Cod_Produto=[SKU], UF=[UF], Quantidade=[Qtd_Trat],
       Valor_Unitario=[Valor_Unit_Trat], Desconto=[Desconto_Trat], Valor_Bruto=[Valor_Bruto],
       Valor_Liquido=[Valor_Liquido], Valor_Afetado=[Valor_Afetado],
       Status=[Status_Trat], Motivo=[Motivo_Trat], CEP=[CEP], Cidade=[Cidade],
       Canal=[Canal_Trat], Dias_Despacho=[Dias_Trat],
       Arquivo_Origem=[Arquivo_Origem], Linha_Origem=[Linha_Origem]
    ],type record)
in RegistroSaida
